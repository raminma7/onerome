# ---------------------------------------------------------------------------
# OneRome environment variables
# Copy to .env.local for development. NEVER commit real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Public URL of the web app (used for auth redirects and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local defaults are printed by `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS. Used by the Stripe webhook and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (use TEST MODE keys in development: sk_test_..., whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly price of €5.99 created in the Stripe dashboard (price_...)
STRIPE_PRICE_ID=

# Web Push (generate with: pnpm exec web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# The private key is only needed by the `push-dispatch` Supabase Edge Function
# (set it with `supabase secrets set`), not by the Next.js app.

# Face verification — AWS Rekognition Face Liveness + CompareFaces (server only)
# IAM user for the server: rekognition:CreateFaceLivenessSession, GetFaceLivenessSessionResults,
# CompareFaces, DetectFaces and sts:AssumeRole on AWS_LIVENESS_ROLE_ARN.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region with Face Liveness support (e.g. eu-west-1 Ireland, eu-central-1 Frankfurt)
AWS_REKOGNITION_REGION=eu-west-1
# Role assumed to mint 15-minute browser credentials limited to rekognition:StartFaceLivenessSession
AWS_LIVENESS_ROLE_ARN=
# Optional thresholds (0-100)
FACE_LIVENESS_MIN_CONFIDENCE=80
FACE_MATCH_MIN_SIMILARITY=90
