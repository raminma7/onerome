-- Shared helpers for the pgTAP suites. Loaded by each test file with \ir.
create extension if not exists pgtap with schema extensions;

create schema if not exists tests;

create or replace function tests.create_user(
  p_email text,
  p_gender public.gender,
  p_interested public.gender[],
  p_birth date default date '1995-05-20',
  p_onboarded boolean default true,
  p_verified boolean default true
)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email, email_confirmed_at, raw_user_meta_data, created_at, updated_at)
  values (v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email, now(),
          jsonb_build_object('birth_date', p_birth, 'locale', 'it'), now(), now());

  update public.profiles
  set display_name = split_part(p_email, '@', 1), gender = p_gender, neighborhood = 'monti',
      relationship_goal = 'long_term', interests = array['cinema', 'art', 'travel'], languages = array['it'],
      onboarding_completed_at = case when p_onboarded then now() end
  where id = v_id;
  update public.preferences set interested_in = p_interested where user_id = v_id;
  insert into public.profile_photos (user_id, storage_path) values (v_id, v_id::text || '/1.webp');
  if p_verified then
    update public.profiles
    set verification = 'verified', verified_at = now(),
        verified_photo_id = (select id from public.profile_photos where user_id = v_id limit 1)
    where id = v_id;
  end if;
  return v_id;
end;
$$;

create or replace function tests.subscribe(p_user uuid, p_status public.subscription_status default 'active')
returns void
language sql
as $$
  insert into public.subscriptions (id, user_id, status, current_period_end)
  values ('sub_' || replace(p_user::text, '-', ''), p_user, p_status, now() + interval '30 days')
  on conflict (id) do update set status = excluded.status, current_period_end = excluded.current_period_end;
$$;

-- Impersonate a user for the rest of the transaction (role + JWT claims).
create or replace function tests.authenticate_as(p_user uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_user, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

grant usage on schema tests to authenticated;
grant execute on all functions in schema tests to authenticated;
